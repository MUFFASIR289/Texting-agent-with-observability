# Copy to .env and fill in. .env is gitignored and never committed.

ENV=dev
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

CONFIG_DIR=config

# The agent's read-only single-table database, and the app's read-write state.
AGENT_DB_PATH=data/customer_agent.db
APP_DB_PATH=data/app.db

# API keys, as JSON. Generate real secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles do not nest: an operator cannot approve, an approver cannot create.
API_KEYS=[{"key_id":"ops-1","secret":"replace-me-operator","role":"operator","accounts":["ACC_A","ACC_B","ACC_C","ACC_D"]},{"key_id":"appr-1","secret":"replace-me-approver","role":"approver","accounts":["ACC_A","ACC_B","ACC_C","ACC_D"]}]

# Per-key cap on the routes that cost money.
RATE_LIMIT_PER_MINUTE=30

# Required from milestone M5 (the agent). Unused before then.
OPENAI_API_KEY=

# gpt-5-nano is the cheapest model available. Leave the per-stage variables
# blank to use the default; set one to upgrade a single stage.
OPENAI_MODEL_DEFAULT=gpt-5-nano
# OPENAI_MODEL_ANALYZE=
# OPENAI_MODEL_SEGMENT=
# OPENAI_MODEL_PLAN=
# OPENAI_MODEL_GENERATE=
# OPENAI_MODEL_OPTIMIZE=
# OPENAI_MODEL_QUERY=

SMS_MAX_CHARACTERS=140

LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
TOKEN_BUDGET_PER_CAMPAIGN=60000
AGENT_MAX_TOOL_ITERATIONS=6
