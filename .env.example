# Copy to .env and fill in. .env is gitignored and never committed.

ENV=dev
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

CONFIG_DIR=config

# The agent's read-only single-table database, and the app's read-write state.
AGENT_DB_PATH=data/customer_agent.db
APP_DB_PATH=data/app.db

# Required from milestone M5 (the agent). Unused before then.
OPENAI_API_KEY=
